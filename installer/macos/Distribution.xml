<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Claude Code · 도티오 원클릭 인스톨러</title>
    <organization>team.dotio</organization>
    <welcome    file="welcome.html"    mime-type="text/html" />
    <conclusion file="conclusion.html" mime-type="text/html" />
    <license    file="license.html"    mime-type="text/html" />

    <!-- macOS 13 (Ventura) or later. Matches what the landing page promises. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="13.0" />
        </allowed-os-versions>
    </volume-check>

    <options customize="never" rootVolumeOnly="true" />

    <choices-outline>
        <line choice="default">
            <line choice="team.dotio.claude-installer" />
        </line>
    </choices-outline>

    <choice id="default" />
    <choice id="team.dotio.claude-installer" visible="false">
        <pkg-ref id="team.dotio.claude-installer" />
    </choice>
    <pkg-ref id="team.dotio.claude-installer" version="1.0.0" onConclusion="none">claude-installer-payload.pkg</pkg-ref>
</installer-gui-script>
