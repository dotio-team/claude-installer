#!/bin/bash
#
# postinstall - runs after the .pkg payload (which is empty) is laid down.
# Does the actual work: ensures Node.js + Git are present, then installs
# claude-code globally via npm. Designed for non-developers, so every
# branch logs loudly and exits with a friendly message.
#
# Run as root (productbuild does this automatically). The original user
# is in $USER, but we mostly act as root — npm -g writes to /usr/local
# which is owned by root on Intel and by the user on Apple Silicon.
#
set -u
PATH="/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"

LOG="/var/log/claude-installer.log"
# Mirror to user-readable spot too, since /var/log needs sudo to tail.
USER_LOG_DIR="${HOME:-/Users/$USER}/Library/Logs/ClaudeInstaller"
mkdir -p "$USER_LOG_DIR" 2>/dev/null
USER_LOG="$USER_LOG_DIR/install.log"

log() {
  local msg
  msg="$(date '+%Y-%m-%d %H:%M:%S')  $*"
  echo "$msg" | tee -a "$LOG" "$USER_LOG" >/dev/null
}

fail() {
  log "FAIL: $*"
  /usr/bin/osascript -e "display dialog \"설치 중 문제가 발생했습니다.\n\n$*\n\n자세한 로그: $USER_LOG\" buttons {\"확인\"} default button 1 with icon stop with title \"Claude Code 인스톨러\"" >/dev/null 2>&1 || true
  exit 1
}

ok() { log "OK: $*"; }

log "==== Claude Code installer starting ===="
log "macOS $(sw_vers -productVersion 2>/dev/null), arch $(uname -m), user $USER"

# --- 1. Node.js -------------------------------------------------------------
need_node=true
if command -v node >/dev/null 2>&1; then
  NODE_V="$(node -v 2>/dev/null | sed 's/^v//')"
  NODE_MAJOR="${NODE_V%%.*}"
  if [ "${NODE_MAJOR:-0}" -ge 18 ] 2>/dev/null; then
    ok "Node.js $NODE_V detected (>= 18), skipping install"
    need_node=false
  else
    log "Node.js $NODE_V is too old (need >= 18), will reinstall"
  fi
fi

if $need_node; then
  log "Downloading Node.js 20 LTS official .pkg..."
  ARCH="$(uname -m)"
  case "$ARCH" in
    arm64) NODE_URL="https://nodejs.org/dist/v20.18.1/node-v20.18.1.pkg" ;;
    x86_64) NODE_URL="https://nodejs.org/dist/v20.18.1/node-v20.18.1.pkg" ;;
    *) fail "지원하지 않는 CPU 아키텍처입니다: $ARCH" ;;
  esac
  NODE_PKG="/tmp/claude-installer-node.pkg"
  rm -f "$NODE_PKG"
  if ! /usr/bin/curl -fsSL --connect-timeout 15 --retry 3 -o "$NODE_PKG" "$NODE_URL"; then
    fail "Node.js 다운로드에 실패했습니다. 인터넷 연결을 확인해주세요."
  fi
  ok "Node.js 다운로드 완료 ($(du -h "$NODE_PKG" | cut -f1))"

  log "Installing Node.js .pkg..."
  if ! /usr/sbin/installer -pkg "$NODE_PKG" -target /; then
    fail "Node.js 설치에 실패했습니다."
  fi
  rm -f "$NODE_PKG"
  hash -r 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1; then
    # Some macOS setups have /usr/local/bin not yet in PATH for this shell.
    export PATH="/usr/local/bin:$PATH"
  fi
  ok "Node.js installed: $(node -v 2>/dev/null || echo unknown)"
fi

# --- 2. Git -----------------------------------------------------------------
# Git is shipped with Xcode Command Line Tools. On a fresh Mac it's missing
# and trying `git --version` opens a system prompt to install CLT. We hide
# behind a check rather than triggering that prompt during a .pkg install,
# which would look broken.
if ! /usr/bin/xcode-select -p >/dev/null 2>&1; then
  log "Xcode Command Line Tools missing — Git is unavailable."
  /usr/bin/osascript -e 'display dialog "Claude Code 동작에 필요한 Git이 설치되어 있지 않습니다.\n\n시스템 창이 곧 뜨면 \"설치\"를 눌러 Xcode Command Line Tools를 설치해주세요. (약 1~2분)\n\n설치가 끝난 뒤 다시 이 인스톨러를 실행하면 자동으로 이어집니다." buttons {"알겠습니다"} default button 1 with icon note with title "Claude Code 인스톨러"' >/dev/null 2>&1 || true
  /usr/bin/xcode-select --install >/dev/null 2>&1 || true
  fail "Xcode Command Line Tools 설치를 먼저 완료해주세요."
fi
if ! command -v git >/dev/null 2>&1; then
  fail "Git이 설치되어 있지 않습니다. (Xcode CLT는 있는데 git이 없음)"
fi
ok "Git $(git --version 2>/dev/null | awk '{print $3}') detected"

# --- 3. Korean username heads-up -------------------------------------------
# npm global install path uses ~/.npm cache. On macOS, non-ASCII characters
# in $HOME are fine in practice (HFS+/APFS handle Unicode), but some npm
# postinstall scripts written for older Node still trip up. Log a warning
# instead of forcing a workaround.
if echo "$USER" | LC_ALL=C grep -q '[^a-zA-Z0-9._-]'; then
  log "Non-ASCII username detected: $USER (macOS handles this, just noting)"
fi

# --- 4. Install claude-code -------------------------------------------------
# Critical correctness note: when we run as root (always for .pkg install,
# whether via the GUI Installer.app or `sudo installer -pkg`), npm needs
# --unsafe-perm so post-install scripts inside @anthropic-ai/claude-code
# (which fetch the platform-native binary) actually execute. Without it,
# npm drops root before running those scripts, they can't write to the
# install dir, and `claude` lands on PATH but errors with "claude native
# binary not installed". We chmod 0755 the lib dir afterward so a later
# user-mode `npm install -g` doesn't fail with EACCES.
log "Installing @anthropic-ai/claude-code via npm..."
if ! npm install -g --unsafe-perm @anthropic-ai/claude-code >>"$LOG" 2>&1; then
  fail "claude-code 설치에 실패했습니다. 인터넷 연결 또는 npm 권한을 확인해주세요."
fi
# Best-effort: hand the global lib back to the GUI user so subsequent
# `npm install -g` from their shell works without sudo. Failure is fine.
GUI_USER="$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null)"
if [ -n "$GUI_USER" ] && [ "$GUI_USER" != "root" ]; then
  NPM_PREFIX="$(npm config get prefix 2>/dev/null || echo /usr/local)"
  /usr/sbin/chown -R "$GUI_USER":staff "$NPM_PREFIX/lib/node_modules" 2>/dev/null || true
  /usr/sbin/chown -R "$GUI_USER":staff "$NPM_PREFIX/bin" 2>/dev/null || true
  log "Handed npm global dirs to user $GUI_USER"
fi
ok "claude-code 설치 완료"

# --- 5. Smoke test ----------------------------------------------------------
# Beyond just `which claude` — run `claude --version` and confirm the native
# binary is actually wired up. The npm package can install successfully but
# leave the binary missing if --unsafe-perm wasn't set (the bug we just hit).
hash -r 2>/dev/null || true
if ! command -v claude >/dev/null 2>&1; then
  log "WARN: claude command not on PATH yet; user may need a new terminal."
else
  CLAUDE_OUT="$(claude --version 2>&1)"
  if echo "$CLAUDE_OUT" | grep -qiE 'claude.*[0-9]+\.[0-9]+'; then
    ok "Smoke test passed: $(echo "$CLAUDE_OUT" | head -1)"
  else
    log "WARN: claude --version returned unexpected output: $CLAUDE_OUT"
    log "      (The package is installed but the native binary may be missing.)"
    # Don't `fail` — installation technically succeeded, this is a runtime warning.
  fi
fi

# --- 6. Drop an uninstall helper -------------------------------------------
UNINSTALL="/usr/local/bin/claude-uninstall"
cat > "$UNINSTALL" <<'EOF'
#!/bin/bash
# Removes claude-code and (optionally) the configuration directory.
set -e
echo "Claude Code를 제거합니다..."
npm uninstall -g @anthropic-ai/claude-code 2>/dev/null || true
if [ "${1:-}" = "--purge" ]; then
  rm -rf "$HOME/.claude"
  echo "설정 파일까지 모두 제거했습니다."
fi
rm -f /usr/local/bin/claude-uninstall
echo "제거가 완료되었습니다."
EOF
chmod 0755 "$UNINSTALL" 2>/dev/null || true
ok "Uninstall helper installed at $UNINSTALL"

log "==== Installer finished successfully ===="
exit 0
